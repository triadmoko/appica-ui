{
  "name": "@appica/ui-svelte",
  "version": "1.1.0",
  "description": "Appica UI components library for Svelte applications",
  "license": "MIT",
  "author": "Appica UI",
  "homepage": "https://appica.dev/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appica-dev/appica-ui.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/appica-dev/appica-ui/issues"
  },
  "keywords": [
    "svelte",
    "components",
    "ui",
    "component-library",
    "design-system",
    "tailwindcss",
    "accessible"
  ],
  "engines": {
    "node": ">=20"
