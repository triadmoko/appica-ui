    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "appica.css",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test-host.*",
    "!src/**/*.test.*",
    "!src/**/*.test-host.*",
    "!src/test/**"
  ],
  "scripts": {
    "sync-exports": "node scripts/sync-exports.mjs",
    "prebuild": "pnpm sync-exports",
    "prepack": "pnpm sync-exports",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "pnpm clean && svelte-package --input src && pnpm build:prune && pnpm build:css",
    "build:prune": "node scripts/prune-dist.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "svelte-package --input src --watch",
    "lint": "eslint src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist appica.css"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.13.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.33.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
